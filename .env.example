# Default database lives at backend/instance/heliodesk.db.
# Set absolute path for persistent hosting, for example:
# DATABASE_URL=sqlite:////var/data/heliodesk.db
# Same-origin frontend needs no API base URL. For separate hosting, build with:
# VITE_API_BASE_URL=https://your-api.example.com
# Hosted only, server-side secret; obtain from dedicated Supabase transaction pooler:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Never expose this via VITE_* or commit real connection strings.
